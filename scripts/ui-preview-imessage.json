 "imessage.shortcut_guide": [
  {
   "number": 1,
   "identifier": "is.workflow.actions.setvariable",
   "text": "«Задать переменную» `nextUrl` = **Входные данные быстрой команды** (адрес задания из ссылки или QR-кода).",
   "original": 1,
   "depth": 0,
   "notes": []
  },
  {
   "number": 2,
   "identifier": "is.workflow.actions.repeat.count",
   "text": "«Повторить» **1000** раз. Внутри — шаги 3–30; Shortcut выходит из цикла сам, когда сервер отвечает `stopped` или `finished`.",
   "original": null,
   "depth": 0,
   "notes": [
    "В исходном цикл шёл по всем контактам сразу (действие 11); здесь — по одному заданию."
   ]
  },
  {
   "number": 3,
   "identifier": "is.workflow.actions.downloadurl",
   "text": "«Получить содержимое URL» из `nextUrl` (метод GET).",
   "original": 1,
   "depth": 1,
   "notes": []
  },
  {
   "number": 4,
   "identifier": "is.workflow.actions.detect.dictionary",
   "text": "«Получить словарь из» содержимого URL.",
   "original": 2,
   "depth": 1,
   "notes": []
  },
  {
   "number": 5,
   "identifier": "is.workflow.actions.setvariable",
   "text": "«Задать переменную» `job` = Словарь.",
   "original": null,
   "depth": 1,
   "notes": []
  },
  {
   "number": 6,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `state` из `job` → переименуйте вывод в `state`.",
   "original": null,
   "depth": 1,
   "notes": []
  },
  {
   "number": 7,
   "identifier": "is.workflow.actions.conditional",
   "text": "«Если» `state` **является** `ready`.",
   "original": null,
   "depth": 1,
   "notes": []
  },
  {
   "number": 8,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `recipient` из `job` → переименуйте вывод в `recipient`.",
   "original": 12,
   "depth": 2,
   "notes": []
  },
  {
   "number": 9,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `message` из `job` → переименуйте вывод в `message`.",
   "original": 13,
   "depth": 2,
   "notes": []
  },
  {
   "number": 10,
   "identifier": "is.workflow.actions.sendmessage",
   "text": "«Отправить сообщение»: Сообщение = `message`, Получатели = `recipient` (переменная, не контакт из списка). **Показывать при выполнении — включено.**",
   "original": 14,
   "depth": 2,
   "notes": []
  },
  {
   "number": 11,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `textAckUrl` из `job` → переименуйте вывод в `textAckUrl`.",
   "original": null,
   "depth": 2,
   "notes": []
  },
  {
   "number": 12,
   "identifier": "is.workflow.actions.downloadurl",
   "text": "«Получить содержимое URL» из `textAckUrl` — сервер отмечает, что шаг текста пройден.",
   "original": 16,
   "depth": 2,
   "notes": []
  },
  {
   "number": 13,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `attachments` из `job` → переименуйте вывод в `attachments`.",
   "original": 5,
   "depth": 2,
   "notes": []
  },
  {
   "number": 14,
   "identifier": "is.workflow.actions.repeat.each",
   "text": "«Повторить с каждым» объектом в `attachments`.",
   "original": 6,
   "depth": 2,
   "notes": []
  },
  {
   "number": 15,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `downloadUrl` из **Repeat Item 2** (элемент этого, вложенного, цикла — не внешнего).",
   "original": 7,
   "depth": 3,
   "notes": []
  },
  {
   "number": 16,
   "identifier": "is.workflow.actions.downloadurl",
   "text": "«Получить содержимое URL» из значения словаря — это файл с именем и типом от сервера.",
   "original": 8,
   "depth": 3,
   "notes": []
  },
  {
   "number": 17,
   "identifier": "is.workflow.actions.sendmessage",
   "text": "«Отправить сообщение»: в поле Сообщение — **только** переменная «Содержимое URL» из шага 16, без пробелов и текста; нажмите на неё → Тип → **Файл**. Получатели = `recipient`. Показывать при выполнении — включено.",
   "original": 18,
   "depth": 3,
   "notes": [
    "В исходном файлы сначала собирались в переменную `files` (действие 9), а затем отправлялись из неё; здесь каждый файл уходит сразу после загрузки.",
    "Если вставить переменную рядом с текстом, Команды превратят файл в его текстовое описание — поэтому поле должно содержать только её."
   ]
  },
  {
   "number": 18,
   "identifier": "is.workflow.actions.repeat.each",
   "text": "Конец «Повторить с каждым».",
   "original": 10,
   "depth": 2,
   "notes": []
  },
  {
   "number": 19,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `ackUrl` из `job` → переименуйте вывод в `ackUrl`.",
   "original": 15,
   "depth": 2,
   "notes": []
  },
  {
   "number": 20,
   "identifier": "is.workflow.actions.downloadurl",
   "text": "«Получить содержимое URL» из `ackUrl` — подтверждение **после** текста и всех вложений (в исходном оно шло до вложений).",
   "original": 16,
   "depth": 2,
   "notes": []
  },
  {
   "number": 21,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `delaySeconds` из `job` → переименуйте вывод в `delaySeconds`.",
   "original": null,
   "depth": 2,
   "notes": []
  },
  {
   "number": 22,
   "identifier": "is.workflow.actions.delay",
   "text": "«Ждать» `delaySeconds` секунд (задаётся в приложении; после последнего — 0).",
   "original": 21,
   "depth": 2,
   "notes": [
    "В исходном пауза была случайной, 20–50 с (действия 20–21); здесь — фиксированная, из приложения."
   ]
  },
  {
   "number": 23,
   "identifier": "is.workflow.actions.conditional",
   "text": "«Иначе».",
   "original": null,
   "depth": 1,
   "notes": []
  },
  {
   "number": 24,
   "identifier": "is.workflow.actions.conditional",
   "text": "Вложенное «Если» `state` **является** `paused`.",
   "original": null,
   "depth": 2,
   "notes": []
  },
  {
   "number": 25,
   "identifier": "is.workflow.actions.getvalueforkey",
   "text": "«Получить значение для ключа» `retrySeconds` из `job` → переименуйте вывод в `retrySeconds`.",
   "original": null,
   "depth": 3,
   "notes": []
  },
  {
   "number": 26,
   "identifier": "is.workflow.actions.delay",
   "text": "«Ждать» `retrySeconds` (15 с) — затем цикл снова спросит сервер.",
   "original": null,
   "depth": 3,
   "notes": []
  },
  {
   "number": 27,
   "identifier": "is.workflow.actions.conditional",
   "text": "«Иначе» (`stopped`, `finished` или ошибка сервера).",
   "original": null,
   "depth": 2,
   "notes": []
  },
  {
   "number": 28,
   "identifier": "is.workflow.actions.exit",
   "text": "«Остановить эту быструю команду».",
   "original": null,
   "depth": 3,
   "notes": []
  },
  {
   "number": 29,
   "identifier": "is.workflow.actions.conditional",
   "text": "Конец вложенного «Если».",
   "original": null,
   "depth": 2,
   "notes": []
  },
  {
   "number": 30,
   "identifier": "is.workflow.actions.conditional",
   "text": "Конец «Если» `ready`.",
   "original": null,
   "depth": 1,
   "notes": []
  },
  {
   "number": 31,
   "identifier": "is.workflow.actions.repeat.count",
   "text": "Конец «Повторить».",
   "original": null,
   "depth": 0,
   "notes": []
  }
 ],
